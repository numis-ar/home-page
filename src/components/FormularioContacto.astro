---
/**
 * FormularioContacto: the "Write to us" section of /contacto (#escribinos), with
 * its two scripts, in the page's language. Rendered only while
 * FORMULARIO_ACTIVO is true in src/data/sitio.ts; when it is not rendered,
 * Astro does not ship its scripts.
 *
 * While ENDPOINT_FORMULARIO is undefined the form targets mailto: (native
 * fallback without JS); the first script turns the fields into a readable
 * email in the visitor's mail client. Once a real endpoint exists, set
 * ENDPOINT_FORMULARIO and the form posts to it, and update /privacidad.
 *
 * The "Reason" select starts on a disabled, empty placeholder and is required,
 * so nobody sends a reason they did not pick. The contact doors (and
 * /contacto?motivo=<valor>) preselect a reason; the email subject is
 * "<ASUNTO_CONSULTA>: <reason>".
 */
import Acciones from "./Acciones.astro";
import Area from "./Area.astro";
import Boton from "./Boton.astro";
import Campo from "./Campo.astro";
import Fila from "./Fila.astro";
import Formulario from "./Formulario.astro";
import Par from "./Par.astro";
import Seccion from "./Seccion.astro";
import Seleccion from "./Seleccion.astro";
import Texto from "./Texto.astro";
import { t, type Idioma } from "../data/i18n";
import { ASUNTO_CONSULTA, CORREO, ENDPOINT_FORMULARIO, enlacePrivacidad, mailto, MOTIVOS } from "../data/sitio";

interface Props {
  idioma?: Idioma;
}

const { idioma = "es" } = Astro.props;
const txt = t(idioma).formulario;

const accion = ENDPOINT_FORMULARIO ?? mailto();
const porCorreo = ENDPOINT_FORMULARIO === undefined;

const motivos = [
  { valor: "", texto: txt.motivoPlaceholder, deshabilitada: true, seleccionada: true },
  ...MOTIVOS(idioma).map((m) => ({ valor: m.valor, texto: m.texto })),
];
const privacidad = enlacePrivacidad(idioma);
---

<Seccion fondo="papel" id="escribinos">
  <Par textoAngosto>
    <div>
      <h2 class="titulo-seccion">{txt.titulo}</h2>
      <p class="secundario texto-angosto">{txt.bajada}</p>
    </div>
    <Formulario
      method="post"
      action={accion}
      enctype={porCorreo ? "text/plain" : undefined}
      data-formulario-contacto={porCorreo ? "correo" : undefined}
      data-asunto={ASUNTO_CONSULTA(idioma)}
    >
      <Fila>
        <Campo etiqueta={txt.nombre} htmlFor="con-nombre">
          <Texto id="con-nombre" name="nombre" placeholder={txt.nombrePlaceholder} required />
        </Campo>
        <Campo etiqueta={txt.correo} htmlFor="con-mail">
          <Texto id="con-mail" name="correo" tipo="email" placeholder="vos@ejemplo.ar" required />
        </Campo>
      </Fila>
      <Campo etiqueta={txt.organizacion} opcional htmlFor="con-org">
        <Texto id="con-org" name="organizacion" placeholder={txt.organizacionPlaceholder} />
      </Campo>
      <Campo etiqueta={txt.motivo} htmlFor="con-tipo">
        <Seleccion id="con-tipo" name="motivo" opciones={motivos} required />
      </Campo>
      <Campo etiqueta={txt.mensaje} htmlFor="con-mensaje" ayuda={txt.mensajeAyuda}>
        <Area id="con-mensaje" name="mensaje" placeholder={txt.mensajePlaceholder} />
      </Campo>
      <div class="formulario__envio">
        <Acciones><Boton type="submit">{porCorreo ? txt.enviarCorreo : txt.enviar}</Boton></Acciones>
        <span class="formulario__nota">
          {porCorreo && txt.notaCorreo}{txt.notaDirecto}<a class="enlace" href={mailto()}>{CORREO}</a>.{" "}
          <a class="enlace" href={privacidad.href}>{txt.notaPrivacidad}</a>.
        </span>
      </div>
    </Formulario>
  </Par>
</Seccion>

<script>
  // Preselect the reason when arriving from a door (/contacto?motivo=...).
  const motivoInicial = new URLSearchParams(window.location.search).get("motivo");
  const seleccionMotivo = document.querySelector<HTMLSelectElement>("#con-tipo");
  if (motivoInicial && seleccionMotivo && [...seleccionMotivo.options].some((o) => o.value === motivoInicial)) {
    seleccionMotivo.value = motivoInicial;
  }
</script>

<script is:inline define:vars={{ script: txt.script }}>
  // mailto: fallback while there is no backend. The browser has already run
  // the native `required`/`type=email` validation when "submit" fires. The
  // field labels come from the page language via define:vars.
  const formulario = document.querySelector('[data-formulario-contacto="correo"]');

  formulario?.addEventListener("submit", (evento) => {
    evento.preventDefault();
    const destino = formulario.getAttribute("action") ?? "";
    const asuntoPrefijo = formulario.getAttribute("data-asunto") ?? "";
    const campo = (nombre) => String(new FormData(formulario).get(nombre) ?? "").trim();
    const motivo = formulario.querySelector("select[name=motivo]");
    const asunto = `${asuntoPrefijo}: ${motivo?.selectedOptions[0]?.text ?? ""}`;
    const organizacion = campo("organizacion");

    const cuerpo = [
      `${script.nombre}: ${campo("nombre")}`,
      `${script.correo}: ${campo("correo")}`,
      ...(organizacion ? [`${script.organizacion}: ${organizacion}`] : []),
      "",
      campo("mensaje"),
    ].join("\n");

    window.location.href = `${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
  });
</script>
