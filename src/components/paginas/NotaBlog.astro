---
/**
 * Note page, one per visible entry of the page language's `blog` collection;
 * unpublished entries get no page (except in `astro dev`, marked "Draft").
 * Header on green with date, title, lead and byline; the Markdown body on
 * paper with the long-form `.prosa` styles (src/styles/base/type.css); a
 * button back to the listing. No printer here: the only automatic animation
 * of the site belongs to the home hero.
 *
 * The page advertises its translations: `alternativas` lists the languages
 * where the same slug exists (the footer switcher and the hreflang links
 * read it), so a note without a translation never points to a 404.
 */
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Acciones from "../../components/Acciones.astro";
import Autores from "../../components/Autores.astro";
import Boton from "../../components/Boton.astro";
import Contenedor from "../../components/Contenedor.astro";
import Hero from "../../components/Hero.astro";
import Seccion from "../../components/Seccion.astro";
import { autoresDe, fechaISO, fechaLarga, notasVisibles, type NotaEntrada } from "../../data/blog";
import { conLocale, IDIOMAS, t, type Idioma } from "../../data/i18n";

interface Props {
  nota: NotaEntrada;
  idioma: Idioma;
}

const { nota, idioma } = Astro.props;
const txt = t(idioma).blog;
const { titulo, fecha, bajada, actualizado } = nota.data;
const autores = await autoresDe(nota);
const { Content } = await render(nota);

// The same note in the other languages: same slug in their visible listings.
const slugsPorIdioma = await Promise.all(IDIOMAS.map(async (i) => ({ idioma: i, slugs: new Set((await notasVisibles(i)).map((n) => n.id)) })));
const alternativas = slugsPorIdioma
  .filter(({ slugs }) => slugs.has(nota.id))
  .map(({ idioma: i }) => ({ idioma: i, href: conLocale(i, `/blog/${nota.id}`) }));
---

<Base title={`${titulo} · ${txt.paginaTitulo}`} description={bajada} idioma={idioma} alternativas={alternativas}>
  <Contenedor>
    <Hero>
      <div>
        <p class="secundario nota-cabeza__fecha">
          <time datetime={fechaISO(fecha)}>{fechaLarga(fecha, idioma)}</time>
          {!nota.data.publicado && ` · ${txt.borrador}`}
          {
            actualizado && (
              <>
                {" "}
                · {txt.actualizadaEl}{" "}
                <time datetime={fechaISO(actualizado)}>{fechaLarga(actualizado, idioma)}</time>
              </>
            )
          }
        </p>
        <h1 class="display nota-cabeza__titulo">{titulo}</h1>
        <p class="lead">{bajada}</p>
        <Autores autores={autores} idioma={idioma} class="nota-cabeza__autores" />
      </div>
    </Hero>
  </Contenedor>

  <Seccion fondo="papel" aria-label={txt.ariaNota.replace("{titulo}", titulo)}>
    <article class="prosa">
      <Content />
    </article>
    <Acciones>
      <Boton href={conLocale(idioma, "/blog")}>{txt.volver}</Boton>
    </Acciones>
  </Seccion>
</Base>
