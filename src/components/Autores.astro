---
/**
 * Autores: the byline of a note, "Por Ana, Beto y Carla" in the page's
 * language. Each name links to the member's block on the same language's
 * /nosotros (its id is the member's slug). Used by the /blog listing and the
 * note page; the link color follows the section, like every .enlace.
 */
import { t, conLocale, type Idioma } from "../data/i18n";
import type { IntegranteEntrada } from "../data/equipo";

interface Props {
  autores: IntegranteEntrada[];
  idioma?: Idioma;
  class?: string;
}

const { autores, idioma = "es", class: className } = Astro.props;
// Separator before each name: nothing for the first, " y " / " and " / " e " for the last, ", " otherwise.
const unir = t(idioma).blog.unir;
const separador = (i: number) => (i === 0 ? "" : i === autores.length - 1 ? ` ${unir} ` : ", ");
---

<p class:list={["autores", className]}>
  {t(idioma).blog.por}{" "}
  {
    autores.map((a, i) => (
      <>
        {separador(i)}
        <a class="enlace" href={conLocale(idioma, `/nosotros#${a.id}`)}>
          {a.data.nombre}
        </a>
      </>
    ))
  }
</p>
