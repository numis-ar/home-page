---
/**
 * Formulario: field grid. Hard 2.5px borders, radius 0, hard shadow on hover and focus.
 * Mirrors `Formulario` in components/formulario/Campo.d.ts.
 */
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"form">;

const { class: className, ...rest } = Astro.props;
---

<form class:list={["formulario", className]} {...rest}><slot /></form>
