---
/** Texto: single-line input. Mirrors `Texto` in Campo.d.ts. */
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"input">, "type"> {
  /** text, email, tel, url... */
  tipo?: HTMLAttributes<"input">["type"];
}

const { tipo = "text", class: className, ...rest } = Astro.props;
---

<input type={tipo} class:list={["campo__control", className]} {...rest} />
