---
/**
 * Proyecto: one project card. Mark, name, type, a perforation, a one-line
 * description and, when the project has its own page, the language's
 * "View project" at the bottom (the whole card is then the link).
 * Without `logo` it draws the yellow "logo missing" hole (same code as .pendiente)
 * and without `descripcion` a <Pendiente>: neither must be published as is.
 * Mirrors components/proyectos/Proyectos.d.ts, plus `descripcion` and the link line.
 */
import Pendiente from "./Pendiente.astro";
import { t, type Idioma } from "../data/i18n";

export interface Props {
  nombre: string;
  /** One or two words: "Investigación", "Implementación", "Territorio". */
  tipo?: string;
  /** Path to the counterpart's logo. */
  logo?: string;
  /** One line about the project. */
  descripcion?: string;
  /** If the project has its own page, the card becomes a link. */
  href?: string;
  idioma?: Idioma;
  class?: string;
}

const { nombre, tipo, logo, descripcion, href, idioma = "es", class: className } = Astro.props;
const txt = t(idioma).proyectos.tarjeta;
const Etiqueta = href ? "a" : "article";
---

<Etiqueta class:list={["proyecto", className]} href={href}>
  <div class:list={["proyecto__marca", !logo && "proyecto__marca--vacia"]}>
    {logo ? <img src={logo} alt="" /> : txt.faltaLogo}
  </div>
  <h3>{nombre}</h3>
  {tipo && <span class="proyecto__tipo">{tipo}</span>}
  <p class="proyecto__descripcion">{descripcion ?? <Pendiente idioma={idioma}>{txt.faltaDescripcion}</Pendiente>}</p>
  {href && <span class="proyecto__ver">{txt.ver}</span>}
</Etiqueta>
