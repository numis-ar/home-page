---
/**
 * Base layout shared by every page: document in the page's language, metadata
 * (canonical, Open Graph, Twitter card, Organization JSON-LD), favicon, font
 * preload, the single Numis stylesheet and the site chrome (header, <main>
 * and footer). Pages only pass what differs: title, description and,
 * optionally, the header's primary button.
 *
 * i18n: every page renders in Spanish (default, URLs at the root), English
 * (/en) and Portuguese (/pt). `idioma` selects the language; the header and
 * footer links, the RSS advert and the language switcher all follow it. The
 * head advertises the other languages of the same page (hreflang): by default
 * it assumes the page exists in all three locales (true for the static
 * routes); dynamic pages (notes, projects) pass `alternativas` with only the
 * languages where the entry actually exists. Every URL is absolute against
 * `site` (https://www.numis.ar, see astro.config.mjs).
 */
import "../styles/numis.css";
import Boton from "../components/Boton.astro";
import Cabecera from "../components/Cabecera.astro";
import Contenedor from "../components/Contenedor.astro";
import Pie from "../components/Pie.astro";
import { notasVisibles, RUTA_RSS } from "../data/blog";
import { proyectosPublicados } from "../data/proyectos";
import {
  IDIOMAS,
  nombreIdioma,
  rutaEnIdioma,
  etiquetaOG,
  t,
  conLocale,
  type Idioma,
} from "../data/i18n";
import {
  accionPrincipal,
  CORREO,
  datosPie,
  enlaceBlog,
  enlacePrivacidad,
  navegacion,
  RAZON_SOCIAL,
  type Enlace,
} from "../data/sitio";

interface Props {
  title: string;
  description: string;
  /** Page language. Defaults to Spanish. */
  idioma?: Idioma;
  /** The page's URLs in the languages where this exact content exists (notes, projects). */
  alternativas?: { idioma: Idioma; href: string }[];
  /** Primary button of the header. Defaults to Escribinos -> /contacto of the language. */
  accion?: Enlace;
}

const { title, description, idioma = "es", alternativas, accion = accionPrincipal(idioma) } = Astro.props;
const txt = t(idioma);
const canonical = new URL(Astro.url.pathname, Astro.site);
const inicio = new URL("/", Astro.site);
const ogImagen = new URL("/og.png", Astro.site);
const hayNotas = (await notasVisibles(idioma)).length > 0;
const enlaces = navegacion(
  { hayProyectos: (await proyectosPublicados(idioma)).length > 0, hayNotas },
  idioma,
);

// hreflang + switcher: explicit alternatives when given, else this same path
// in every locale (static routes exist in all three).
const locales = alternativas ?? IDIOMAS.map((i) => ({ idioma: i, href: rutaEnIdioma(Astro.url.pathname, i) }));
const urlDe = (href: string) => new URL(href, Astro.site).href;
const enlaceBlogLocale = enlaceBlog(idioma);
const enlacePrivacidadLocale = enlacePrivacidad(idioma);

// Organization structured data: confirmed facts only, no sameAs (there are no
// social profiles). Institutional data does not change with the language.
const organizacion = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Numis",
  legalName: RAZON_SOCIAL,
  url: inicio.href,
  // Google does not accept SVG logos: a square PNG of at least 112px.
  logo: new URL("/logo/numis-logo.png", Astro.site).href,
  email: CORREO,
  address: { "@type": "PostalAddress", addressLocality: "Ciudad Autónoma de Buenos Aires", addressCountry: "AR" },
};

// WebSite structured data: tells Google to show "Numis" as the site name in
// results instead of the bare domain.
const sitioWeb = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Numis",
  alternateName: ["Cooperativa Numis", "numis.ar"],
  url: inicio.href,
};
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l.idioma} href={urlDe(l.href)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={urlDe(rutaEnIdioma(Astro.url.pathname, "es"))} />
    {hayNotas && <link rel="alternate" type="application/rss+xml" title={txt.blog.titulo} href={new URL(conLocale(idioma, RUTA_RSS), Astro.site)} />}
    <link rel="preload" href="/fonts/archivo-variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={etiquetaOG[idioma]} />
    <meta property="og:site_name" content="Numis" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Logo de Numis, la frase «Pagos con reglas que se pueden ver.» y el lema «finanzas para todas las personas»."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizacion)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(sitioWeb)} />
  </head>
  <body>
    <Contenedor>
      <Cabecera logoAlt={txt.cabecera.logoAlt} navAria={txt.cabecera.navAria}>
        {
          enlaces.map((e) => (
            <Boton variante="hueco" href={e.href}>
              {e.texto}
            </Boton>
          ))
        }
        <Boton href={accion.href}>{accion.texto}</Boton>
      </Cabecera>
    </Contenedor>

    <main>
      <slot />
    </main>

    <Pie datos={datosPie(idioma)} lema={txt.pie.lema} logoAlt={txt.cabecera.logoAlt}>
      {txt.pie.legal}
      <span class="pie__enlaces">
        {hayNotas && <a class="enlace pie__enlace" href={enlaceBlogLocale.href}>{enlaceBlogLocale.texto}</a>}
        <a class="enlace pie__enlace" href={enlacePrivacidadLocale.href}>{enlacePrivacidadLocale.texto}</a>
        <span class="pie__idiomas" role="group" aria-label={txt.pie.idiomasAria}>
          {
            locales.map((l) =>
              l.idioma === idioma ? (
                <span aria-current="true">{nombreIdioma[l.idioma]}</span>
              ) : (
                <a class="enlace" href={l.href} hreflang={l.idioma} lang={l.idioma}>
                  {nombreIdioma[l.idioma]}
                </a>
              ),
            )
          }
        </span>
      </span>
    </Pie>
  </body>
</html>
