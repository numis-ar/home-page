---
import NotaBlog from "../../components/paginas/NotaBlog.astro";
import { notasVisibles } from "../../data/blog";

export async function getStaticPaths() {
  return (await notasVisibles("es")).map((nota) => ({ params: { slug: nota.id }, props: { nota } }));
}

interface Props {
  nota: import("../../data/blog").NotaEntrada;
}

const { nota } = Astro.props;
---

<NotaBlog nota={nota} idioma="es" />
